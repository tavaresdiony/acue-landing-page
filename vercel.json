{
  "redirects": [
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/x",
      "destination": "/?utm_source=x&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/dv",
      "destination": "/?utm_source=divulgacao&utm_medium=grupo",
      "permanent": false
    },
    {
      "source": "/ads",
      "destination": "/?utm_source=meta_ads&utm_medium=paid",
      "permanent": false
    },
    {
      "source": "/yt",
      "destination": "/?utm_source=youtube&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/yt-app",
      "destination": "https://www.acueapp.com.br/?cadastro=1&utm_source=youtube&utm_medium=bio_app",
