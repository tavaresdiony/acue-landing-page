{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/x",
      "destination": "/?utm_source=x&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/dv",
      "destination": "/?utm_source=divulgacao&utm_medium=grupo",
      "permanent": false
    },
    {
      "source": "/ads",
      "destination": "/?utm_source=meta_ads&utm_medium=paid",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
